# Local development: copy to .env.local (gitignored) and fill APP_SECRET.
# Production uses deploy/env.example instead.

SITE_URL=http://localhost:3000
# Dev Postgres from `npm run db:up` (container splitscreen-v3-pg).
DATABASE_URL=postgres://ssm:ssm@127.0.0.1:5433/v3_dev
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
STORAGE_DIR=./storage
NOINDEX=1
BETA=1
LOG_LEVEL=info

# Optional: OAuth (both values per provider), SMTP (both or neither), IGDB.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
MAIL_FROM=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
