# Production environment: /root/v3/.env on the server, mode 600. Never commit the filled file.
# docs/ARCHITECTURE.md section 9.4. DATABASE_URL, STORAGE_DIR, STORAGE_ACCEL_PREFIX and TRUST_PROXY are set
# by docker-compose.yml.

# Image tag to run (git short sha of the build)
SITE_TAG=
SITE_URL=https://v3.splitscreen.me
# Indexing stays off unless exactly 0
NOINDEX=1
# 1 shows the beta banner
BETA=1

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32  (HMAC key for IP hashes and download dedup)
APP_SECRET=

# OAuth logins: a provider is enabled when both values are set.
# Redirect URI to register: ${SITE_URL}/api/auth/oauth/<provider>/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (both or neither): smtps://user:pass@host:465 or smtp://user:pass@host:587 (STARTTLS required)
SMTP_URL=
MAIL_FROM=

# IGDB (Twitch app credentials): needed to create handlers and fetch screenshots
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Discord webhooks: keep unset during the beta
DISCORD_WEBHOOK_ADMIN=
DISCORD_WEBHOOK_RELEASES=

LOG_LEVEL=info
