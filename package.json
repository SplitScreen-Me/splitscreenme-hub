{
  "name": "splitscreenme-site",
  "version": "3.0.0-beta",
  "private": true,
  "description": "SplitScreen.Me: landing, handler hub, accounts, backoffice, docs and public API in one Next.js app.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "predev": "node scripts/copy-swagger.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-swagger.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && node scripts/check-security.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:up": "node scripts/dev-db.mjs up",
    "db:down": "node scripts/dev-db.mjs down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "15.5.27",
    "bcryptjs": "3.0.3",
    "busboy": "1.6.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lru-cache": "11.5.3",
    "next": "15.5.27",
    "nodemailer": "10.0.11",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@shikijs/rehype": "4.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/busboy": "1.5.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "github-slugger": "2.0.0",
    "mongodb": "6.16.0",
    "prettier": "3.9.9",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "shiki": "4.4.3",
    "swagger-ui-dist": "5.33.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
